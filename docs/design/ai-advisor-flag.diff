new file mode 100644
index 0000000..fd3af75
--- /dev/null
+++ b/crm/waterfind.com.au/src/com/waterfind/action/ChangeAiAdvisorStatusAction.java
@@ -0,0 +1,62 @@
+package com.waterfind.action;
+
+
+import java.io.IOException;
+
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+
+import org.apache.log4j.Logger;
+import org.apache.struts.action.ActionForm;
+import org.apache.struts.action.ActionForward;
+import org.apache.struts.action.ActionMapping;
+
+import com.waterfind.annotation.AccessRestriction;
+import com.waterfind.annotation.JsonAction;
+import com.waterfind.core.WaterfindUser;
+import com.waterfind.server.WaterfindDelegate;
+import com.waterfind.util.errors.WaterfindErrors;
+
+@JsonAction
+@AccessRestriction(allow = {WaterfindUser.USER_ADMIN, WaterfindUser.USER_BROKER, WaterfindUser.USER_SALES})
+public class ChangeAiAdvisorStatusAction extends WaterfindAction {
+	
+	private static Logger logger = Logger.getLogger(ChangeAiAdvisorStatusAction.class);
+	
+	// Populate the delegate from the ServiceLocator.
+    protected WaterfindDelegate delegate = com.waterfind.Waterfind.getWaterfindDelegate();
+
+	
+	@Override
+	protected ActionForward executeWaterfindAction(ActionMapping mapping,
+			ActionForm form, HttpServletRequest request,
+			HttpServletResponse response) throws WaterfindErrors {
+		
+		// get parameters
+		String _waterfindUserId = request.getParameter("waterfindUserId");
+		String aiAdvisorChecked_ = request.getParameter("aiAdvisor");
+		
+		Long waterfindUserId = Long.parseLong(_waterfindUserId);
+		boolean aiAdvisor = Boolean.parseBoolean(aiAdvisorChecked_);
+		
+		try {
+			
+			boolean result = delegate.updateWaterfindUserAiAdvisor(waterfindUserId, aiAdvisor);
+			
+			this.writeJsonResponse(response, result);
+			
+		}catch(Exception e) {
+			logger.debug("## Change AI Advisor status failed");
+			try {
+				this.writeJsonResponse(response, false);
+			} catch (IOException e1) {
+				e1.printStackTrace();
+			}
+		}
+		
+		return null;
+		
+	}
+	
+	
+}
