+
+function changeAiAdvisorStatus() {
+    var aiAdvisor = $("input[name='ai_advisor']:checked").val();
+    
+    // Store the currently selected radio button
+    var selectedRadio = $("input[name='ai_advisor']:checked");
+    
+    // Find the previously selected value (the other radio button)
+    var otherRadio = $("input[name='ai_advisor']").not(':checked');
+    
+    // Confirmation message based on AI Advisor status
+    var confirmMessage;
+    if(aiAdvisor == 'true') {
+        confirmMessage = 'Do you want to enable the AI Advisor?';
+    } else {
+        confirmMessage = 'Do you want to disable the AI Advisor?';
+    }
+    
+    // Show confirmation dialog
+    if(confirm(confirmMessage)) {
+        // User clicked "Yes/OK" - proceed with AJAX call
+        var params = 'waterfindUserId=' + $('#userId').val();
+        params += '&aiAdvisor=' + aiAdvisor;
+        
+        $.ajax({
+            type: "GET",
+            url: '/change-ai-advisor-status.html',
+            data: params,
+            success: function(result) {
+                if(result) {
+                    console.log(result);
+                    alert('AI Advisor status updated successfully!');
+                } else {
+                    alert('Error on updating AI Advisor status!');
+                    // Revert radio button on error
+                    otherRadio.prop('checked', true);
+                }
+            },
+            error: function() {
+                alert('Got an error');
+                // Revert radio button on error
+                otherRadio.prop('checked', true);
+            },
+            cache: false
+        });
+    } else {
+        // User clicked "Cancel" - revert the radio button selection
+        otherRadio.prop('checked', true);
+        console.log('AI Advisor status change cancelled by user');
+    }
+}
