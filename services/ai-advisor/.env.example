# Waterfind AI Advisor sidecar — copy to .env and fill in. NEVER commit .env.

# HTTP
PORT=3100
# Browser origin(s) allowed to call this service (the CRM). Comma-separated.
CORS_ORIGINS=http://localhost:81

# Shared secret used to verify the HMAC token minted by the CRM JSP.
# MUST match the value in ${user.home}/.waterfind-ai-advisor.properties that the JSP reads.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AIADVISOR_SHARED_SECRET=

# Token lifetime the service will accept (seconds). Keep short.
AIADVISOR_TOKEN_TTL=1800

# PostgreSQL (the running local waterfind-db; the service uses its own schema `ai_advisor`).
PGHOST=localhost
PGPORT=5432
PGUSER=waterfind
PGPASSWORD=
PGDATABASE=waterfind-db
PGSCHEMA=ai_advisor

# Anthropic auth for the Claude Agent SDK.
# Optional: if unset, the SDK uses the host's Claude Code credentials (~/.claude).
# For a real server deployment, prefer an explicit API key.
ANTHROPIC_API_KEY=

# Model + limits for the advisor agent.
AIADVISOR_MODEL=opus
AIADVISOR_MAX_TURNS=12
AIADVISOR_TURN_TIMEOUT_MS=180000
# Max concurrent in-flight advisor queries per user.
AIADVISOR_MAX_CONCURRENCY_PER_USER=2

# Read-only role for data-grounding tools (created by db/grants-rls.sql). Snapshot as-of date.
PGRO_USER=ai_advisor_ro
PGRO_PASSWORD=ai_ro_local
AIADVISOR_ASOF=2026-06-15

# Speech, on every chat surface (client AI Advisor tab, broker Client Rail, AI Trainer):
#  - Dictation (speech-to-text, the composer mic + hands-free voice mode) = OpenAI realtime. If no
#    key is set, the /me capability flag is false and the mic stays hidden — nothing else changes.
#    Prefer AIADVISOR_OPENAI_API_KEY; OPENAI_API_KEY is also honoured.
#  - Read-aloud (text-to-speech: Listen buttons, spoken replies, voice mode) = OpenAI gpt-4o-mini-tts
#    on the same key (voice "ash" + an Australian-accent instruction by default; see misc below) —
#    UNLESS the Retell web reader below is switched on, which speaks in the phone channel's voice.
AIADVISOR_OPENAI_API_KEY=

# Web reader = the phone channel's Retell voice (11labs-Noah) in the browser, on every chat surface:
# each spoken reply is a Retell WEB CALL to a dedicated reader agent (custom-LLM socket fed by this
# sidecar; the browser joins with Retell's SDK, mic muted). Needs the voice section below configured
# (RETELL_API_KEY, public base + ws token) and the reader agent: `npm run voice:setup -- --reader`.
# REVERT: remove AIADVISOR_WEB_READER (or set it to openai) and restart — every surface goes back to the
# OpenAI reader; nothing CRM-side changes. Per-minute cost ≈ $0.095 (Retell engine + ElevenLabs voice).
# AIADVISOR_WEB_READER=retell
# AIADVISOR_VOICE_READER_AGENT_ID=agent_...        # printed by voice:setup --reader
# AIADVISOR_READER_RETELL_BASE=https://api.retellai.com   # only when RETELL_API_BASE points the PHONE side at a local fake (demos)
# AIADVISOR_READER_MAX_PER_USER=3 / AIADVISOR_READER_MAX_TOTAL=40 / AIADVISOR_READER_SESSION_TTL_MS=600000 / AIADVISOR_READER_MAX_CHARS=12000
AIADVISOR_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Live-dictation language: an ISO-639-1 code pins recognition (default en); auto = detect per utterance. The browser may override per session.
# AIADVISOR_TRANSCRIBE_LANGUAGE=en
# Optional extra prompt-bias vocabulary (region names etc.); appended to the built-in water terms.
AIADVISOR_TRANSCRIBE_VOCAB=
# Max bytes for one dictation clip (OpenAI hard-caps at 25 MB = 26214400).
AIADVISOR_TRANSCRIBE_MAX_BYTES=26214400

# Brokerage: the CRM order-execution seam (/ai-broker-exec.html — see crm-seam/README.md).
# Dedicated server-to-server secret; MUST match wf.ai.exec-secret in
# ${user.home}/.waterfind-ai-advisor.properties. Distinct from AIADVISOR_SHARED_SECRET.
AIADVISOR_EXEC_SECRET=
AIADVISOR_CRM_BASE=http://localhost:81
# Minutes a prepared (unconfirmed) order stays confirmable on the card.
AIADVISOR_PENDING_ORDER_TTL_MIN=30

# AI Trainer — the tool behind the CRM's "AI Trainer Home" (crm-seam/README.md): staff maintain the
# advisor's documents + notes through a chat assistant or directly; every change is ledgered (undo /
# restore). Off by default. When on, a caller must be a Waterfind STAFF account (broker/sales/admin
# usertype) AND hold the CRM role below, both verified fresh from the database per request, fail-closed.
# (The pre-redesign CURATOR_* names are still honoured.)
TRAINER_ENABLED=0
# The CRM role (public.user_role.role_id) that grants the trainer. Create it once with
# db/ai-trainer-role.sql (or Manage User Roles in the CRM); assign it per staff user in the CRM.
# An EMPTY value drops the role check and admits any staff account — only for replicas without roles.
TRAINER_ROLE_ID=AI_TRAINER
# OPT-IN: each change is also a pathspec-limited git commit on the checkout's CURRENT branch. Right
# for a deployment pinned to its release branch; wrong for a developer's working tree (default 0).
# Even when on the trainer refuses to commit on main, in a detached HEAD or mid-merge.
# TRAINER_GIT_COMMIT=0
# Startup maintenance: reconcile knowledge/ on disk against the ledger (changes made outside the
# Trainer — git pull, a developer edit — are recorded as via=external events, actor 0 = system) and
# re-commit any ledgered change git missed. 0 = skip (one-off scripts, tests).
# TRAINER_MAINTENANCE=1
# Upload size cap and the model used to annotate uploads (default: the advisor model).
# TRAINER_UPLOAD_MAX_BYTES=33554432
# TRAINER_ANNOTATE_MODEL=
# Staff notes: pinned notes ride in the advisor's system prompt, retrieve-mode notes surface through
# search_knowledge. ADVISOR_NOTES=0 switches BOTH off — the kill switch for a bad note.
# ADVISOR_NOTES=1

# ---- knowledge auto-refresh (best-by dates on documents + notes) ----
# When an item's best_by frontmatter date passes (no best_by = as_at + TTL; best_by: never = opted
# out), a sandboxed agent re-verifies it against its sources: confirmed (dates bumped), updated
# (corrected — ledgered as via=refresh, undoable from History), or flagged for staff. Each run is
# emailed to every staff account holding the AI Trainer role. Default: ON when TRAINER_ENABLED=1,
# OFF otherwise (a dev sidecar must not quietly spend tokens); KB_REFRESH=1/0 overrides.
# KB_REFRESH=
# KB_REFRESH_CHECK_MS=21600000               # scheduler tick (6h); dueness lives in the files, so a
#                                            # sidecar that was down catches up on its boot pass
# KB_REFRESH_TTL_DAYS=180                    # implied best_by for items without one (as_at + TTL)
# KB_REFRESH_MAX_PER_TICK=8                  # agent runs per pass; the rest defer to the next pass
# KB_REFRESH_MODEL=                          # default AIADVISOR_MODEL
# KB_REFRESH_MIN_INTERVAL_DAYS=7             # bounds on the next best_by the agent proposes
# KB_REFRESH_MAX_INTERVAL_DAYS=365
# KB_REFRESH_ERROR_BACKOFF_H=24              # retry throttle after a failed check
# KB_REFRESH_FLAGGED_BACKOFF_H=168           # retry throttle after "needs attention"
# KB_REFRESH_NOTIFY_TO=                      # REPLACE the trainer-role recipient list (dev/replicas)
# KB_REFRESH_NOTIFY_EXTRA=                   # extra recipients appended to the role list

# ---- outbound email (the refresh digest) ----
# The CRM mails through SendGrid SMTP; the same host + apikey credentials work here. No host set =
# console mode: the digest is logged and recorded on the run, never sent.
# AIADVISOR_SMTP_HOST=smtp.sendgrid.net
# AIADVISOR_SMTP_PORT=587
# AIADVISOR_SMTP_USER=apikey
# AIADVISOR_SMTP_PASSWORD=
# AIADVISOR_SMTP_SECURE=0                    # 1 = implicit TLS (port 465)
# AIADVISOR_MAIL_FROM=ai-advisor@waterfind.com.au

# ---- broker-assist surface (advisor on the CRM client page; call notes live under it) ----
# ASSIST_ENABLED=1                           # 0 = kill switch (routes 404)
# ASSIST_ROLES=BROKER,SU                     # CRM roles (any one) a STAFF account needs — mirrors the CRM's
#                                            # own gate on client recordings. Empty = usertype only (replicas).

# ---- misc (all optional) ----
# ADVISOR_AUTO_REFRESH=1                     # 0 = no in-process refresh of knowledge/data/*.json
# ADVISOR_REFRESH_CHECK_MS=                  # scheduler tick
# ADVISOR_HAIKU_TITLES=1                     # 0 = derived chat titles instead of the haiku titler
# ADVISOR_TITLER_MODEL=claude-haiku-4-5-20251001
# KNOWLEDGE_DIR=                             # override the knowledge/ root (tests use a scratch dir)
# AIADVISOR_TTS_MODEL=gpt-4o-mini-tts / AIADVISOR_TTS_VOICE=ash / AIADVISOR_TTS_INSTRUCTIONS=   # read-aloud voice + style
# AIADVISOR_TTS_CHUNK_CHARS=1800 / AIADVISOR_TTS_MAX_INPUT_CHARS=8000        # read-aloud chunking / long-reply cap
# AIADVISOR_TRANSCRIBE_REALTIME_URL=         # live dictation websocket upstream
# AIADVISOR_TRANSCRIBE_STREAM_MODEL=whisper-1  # live dictation model. Keep a plain ASR model: the
#                                              # gpt-4o transcribe family follows instructions heard
#                                              # in the audio (answered "give me a summary of my
#                                              # account" with an essay about the vocab prompt)

# ---- call notes (transcribe a logged phone call, draft the broker's file note, prefill the CRM's Add Comment popup) ----
# AIADVISOR_CALL_NOTES=1                     # 0 = feature off (prefill route 404s, worker idle)
# AIADVISOR_CALL_NOTES_AUTO=1                # 0 = no pre-drafting worker (drafts start only when a popup asks)
# AIADVISOR_CALL_NOTES_AUTO_LOOKBACK_MINUTES=60  # calls that started within this window are pre-drafted (older ones draft on demand)
# AIADVISOR_CALL_NOTE_PREFILL_WINDOW_MINUTES=180 # the popup prefills the broker's latest call that ended within this window
# AIADVISOR_PBX_SOURCE=off                   # DEFAULT off = never contacts a PBX (nothing is drafted);
#                                            # db  = the CRM's phone_system_settings row (set this in production);
#                                            # env = the AIADVISOR_PBX_* values below (dev/test against the fake PBX)
# AIADVISOR_PBX_BASE_URL=http://127.0.0.1:7866/
# AIADVISOR_PBX_USER=wfsupport
# AIADVISOR_PBX_PASSWORD=secret
# AIADVISOR_PBX_PROXY=http://127.0.0.1:9446   # HTTP proxy for PBX requests ONLY. The portal whitelists
#                                             # caller IPs; on a host without a static IP set this to the
#                                             # wf-tunnel forward (-> tinyproxy on the Hetzner box, egress
#                                             # 5.78.145.207, the whitelisted IP). Empty = direct.
# AIADVISOR_CALL_STT_MODEL=gpt-4o-transcribe-diarize
# AIADVISOR_CALL_NOTE_MODEL=                 # defaults to AIADVISOR_MODEL
# AIADVISOR_CALL_RECORDING_MAX_AGE_DAYS=180  # mirrors the CRM's own recording-link window
# AIADVISOR_CALL_NOTE_RETENTION_DAYS=0       # 0 = keep transcript+draft indefinitely (default); >0 blanks them after N days (audit row stays)
# AIADVISOR_PBX_STEREO_BROKER=unknown        # left|right when the PBX records one leg per channel (dual-mono is auto-detected + mixed down)
# AIADVISOR_CRM_TZ=Australia/Adelaide        # zone the CRM JVM writes contact.date_edited in (all call ages/windows go through it)
# AIADVISOR_CALL_MAX_BYTES=62914560          # per-recording cap (60 MB); checked against Content-Length before buffering
# AIADVISOR_CALL_ONESHOT_MAX_BYTES=25165824  # cap for containers that cannot be split (mp3/webm/compressed WAV)
# AIADVISOR_CALL_NOTE_BYTES_IN_FLIGHT=268435456  # process-wide audio memory budget; 429 beyond it
# AIADVISOR_CALL_NOTE_DAILY_BUDGET_USD=20    # rolling-24h drafting spend cap (0 = off); beyond it no new draft starts (popups stay empty)

# ---- voice calls (Retell phone channel: inbound + outbound; see docs/design/voice-calls-design.md) ----
# AIADVISOR_VOICE_ENABLED=1                      # master switch — off: every /voice/* route 404s except GET /voice/health
# RETELL_API_KEY=key_...                         # Retell account (dev account is fine; production = Waterfind's)
# RETELL_WEBHOOK_KEY=key_...                     # the API key with the "webhook" badge in the Retell dashboard — webhooks are signed with THAT one (defaults to RETELL_API_KEY)
# AIADVISOR_VOICE_WEBHOOK_TRUSTED_IPS=           # DEFAULT EMPTY = signature only. Optionally Retell's egress IP (100.20.5.228) as an alternative
#                                                # acceptance path; the forwarded-for header is only trusted from the loopback tunnel, and a PRESENT
#                                                # but invalid signature is rejected regardless of IP.
# AIADVISOR_VOICE_WEBHOOK_DEBUG=0                # 1 = append raw webhook bodies (transcripts!) to webhook-capture.log — dev only
# AIADVISOR_VOICE_PUBLIC_BASE=https://water.underthetable.lol   # public origin Retell reaches us on (wss + webhook derive from it)
# AIADVISOR_VOICE_PUBLIC_PREFIX=/advisor         # path prefix the tunnel serves the sidecar under (Caddy strips it)
# AIADVISOR_VOICE_WS_TOKEN=<random 32+ chars>    # secret path segment on the Custom-LLM websocket URL
# AIADVISOR_VOICE_INBOUND_AGENT_ID=agent_...     # printed by: npm run voice:setup
# AIADVISOR_VOICE_OUTBOUND_AGENT_ID=agent_...
# AIADVISOR_VOICE_VOICE_ID=11labs-Noah            # Noah (en-AU), the Australian stock voice; the cloned Waterfind voice id later (npm run voice:setup -- --voices)
# Retell locales the agents listen for (the agent's `language` list) and the languages a call can be detected as. English only by default;
# add locales for a multilingual agent (needs a multilingual voice). No Punjabi or Khmer in Retell's list. Nothing is stored per client.
# AIADVISOR_VOICE_LANGUAGES=en-AU,vi-VN,it-IT,el-GR,hi-IN,zh-CN,tr-TR,ar-SA
# AIADVISOR_VOICE_BACKEND=auto                    # api (Messages API, needs ANTHROPIC_API_KEY, ~1s first audio) | sdk (host creds, 5-10s) | auto
# AIADVISOR_VOICE_MODEL=claude-sonnet-5           # api backend model
# AIADVISOR_VOICE_SDK_MODEL=sonnet                # sdk backend model alias
# AIADVISOR_VOICE_OTP_TRANSPORT=console           # console (dev: code printed to the log) | webhook (Waterfind's SMS/email gateway)
# AIADVISOR_VOICE_OTP_DEV=1                       # console transport delivers ONLY with this on (default on unless NODE_ENV=production); webhook without a URL = transport_failed, never "sent"
# AIADVISOR_VOICE_OTP_WEBHOOK_URL=
# AIADVISOR_VOICE_OTP_WEBHOOK_SECRET=
# AIADVISOR_VOICE_OTP_PEPPER=<random>             # server pepper for OTP hashes (unset = warned at boot)
# AIADVISOR_VOICE_KNOWLEDGE_MAX_ATTEMPTS=3        # verify_caller_details attempts per call (then OTP/callback only)
# AIADVISOR_VOICE_KNOWLEDGE_MAX_ATTEMPTS_PER_CLIENT_HOUR=6
# AIADVISOR_VOICE_WEBHOOK_MAX_BODY_BYTES=2097152  # raw webhook body cap
# AIADVISOR_VOICE_OUTBOUND_COUNTRY_CODES=         # extra dial-out country codes besides 61 (AU), e.g. 64
# AIADVISOR_VOICE_CALLBACK_NUMBERS=               # extra E.164 numbers an outbound payload may name as callback_number
# AIADVISOR_VOICE_TEST_CALLERS=+61400111222:119063  # dev only: caller-ID → client uid (the local DB's mobiles are masked)
# AIADVISOR_VOICE_TRANSFER_ENABLED=1
# AIADVISOR_VOICE_TRANSFER_TO_BROKER=1            # transfer to the assigned broker's business number from the CRM
# AIADVISOR_VOICE_TRANSFER_NUMBER=+61...          # broker-desk fallback (E.164)
# AIADVISOR_VOICE_OUTBOUND_ENABLED=0              # the DIALER kill switch — leave 0 until legal basis + number exist
# AIADVISOR_VOICE_FROM_NUMBER=+61...              # outbound caller ID (the imported number; printed by voice:setup -- --import)
# --- the number: Retell sells no AU numbers. Ours = Twilio AU MOBILE number on an Elastic SIP trunk (origination
# --- sip:sip.retellai.com; termination = the trunk's SYDNEY-localised URI — AU→AU calls must use the Sydney edge),
# --- registered with: npm run voice:setup -- --import +61...   (design doc §11)
# AIADVISOR_VOICE_SIP_TERMINATION_URI=<trunk>.pstn.sydney.twilio.com
# AIADVISOR_VOICE_SIP_USERNAME=                   # trunk credential-list user (leave both empty for an IP-ACL trunk: 18.98.16.120/30)
# AIADVISOR_VOICE_SIP_PASSWORD=
# AIADVISOR_VOICE_OUTBOUND_WEBHOOK_SECRET=<random> # bearer for POST /voice/outbound (the agnostic trigger)
# AIADVISOR_VOICE_OUTBOUND_ON_ORDER=0             # integrated trigger: advisor-placed order → order_confirmation call
# AIADVISOR_VOICE_CALL_HOURS=09:00-20:00          # calling/transfer window in AIADVISOR_VOICE_TZ
# AIADVISOR_VOICE_CALL_WEEKDAYS_ONLY=0
# AIADVISOR_VOICE_TZ=Australia/Sydney
# AIADVISOR_VOICE_OUTBOUND_DAILY_CAP=2            # per client per day
# AIADVISOR_VOICE_CAMPAIGN_MAX_CONCURRENT=3       # call campaigns (CRM "Call Campaigns" page): default calls in flight per campaign
# AIADVISOR_VOICE_CAMPAIGN_POLL_MS=15000          # how often running campaigns are paced into the outbound queue
# AIADVISOR_VOICE_DEMO=1                          # browser web-call demo at /voice/demo
# AIADVISOR_VOICE_DEMO_KEY=<random>
# AIADVISOR_VOICE_RETENTION_DAYS=0                # >0 blanks transcript+summary after N days (audit row stays)

# ---- spend ledger (AI Trainer > Costs; src/spend.ts, db/spend.sql) ----
# AIADVISOR_SPEND_LEDGER=1                   # 0 = record nothing (the offline unit suites set this)
# AIADVISOR_PRICES_JSON=                     # per-model list-price overrides for the ESTIMATED rows (OpenAI audio/TTS, Messages-API tokens), e.g.
#                                            # {"anthropic":{"claude-sonnet-5":{"input":2,"output":10}},"openai_audio_per_min":{"whisper-1":0.006},"openai_tts_per_mchars":{"gpt-4o-mini-tts":20}}
